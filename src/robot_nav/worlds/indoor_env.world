<?xml version="1.0" ?>
<!--
  indoor_env.world - 室内导航仿真场景
  房间尺寸：6m x 6m
  包含：墙壁、障碍物（箱子/桌子）、目标对象（person 模型）
-->
<sdf version="1.6">
  <world name="indoor_env">

    <!-- ==================== 光照 ==================== -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <light name="room_light" type="point">
      <pose>0 0 2.5 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>10</range>
        <constant>0.5</constant>
        <linear>0.1</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <!-- ==================== 地面 ==================== -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <surface>
            <friction><ode><mu>100</mu><mu2>50</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ==================== 房间墙壁（6m x 6m） ==================== -->

    <!-- 北墙（y=3） -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 3 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6.4 0.2 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6.4 0.2 3.0</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 南墙（y=-3） -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -3 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6.4 0.2 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6.4 0.2 3.0</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 东墙（x=3） -->
    <model name="wall_east">
      <static>true</static>
      <pose>3 0 1.5 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6.4 0.2 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6.4 0.2 3.0</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 西墙（x=-3） -->
    <model name="wall_west">
      <static>true</static>
      <pose>-3 0 1.5 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6.4 0.2 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6.4 0.2 3.0</size></box></geometry>
          <material><ambient>0.85 0.85 0.8 1</ambient><diffuse>0.85 0.85 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== 障碍物 ==================== -->

    <!-- 障碍物1：大箱子（导航路径上） -->
    <model name="box_obstacle_1">
      <static>true</static>
      <pose>0.5 1.0 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 0.6 0.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.6 0.6</size></box></geometry>
          <material><ambient>0.7 0.5 0.3 1</ambient><diffuse>0.7 0.5 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 障碍物2：桌子（左侧） -->
    <model name="table_obstacle">
      <static>true</static>
      <pose>-1.5 0.5 0 0 0 0</pose>
      <link name="link">
        <collision name="top_collision">
          <pose>0 0 0.7 0 0 0</pose>
          <geometry><box><size>1.0 0.5 0.05</size></box></geometry>
        </collision>
        <visual name="top_visual">
          <pose>0 0 0.7 0 0 0</pose>
          <geometry><box><size>1.0 0.5 0.05</size></box></geometry>
          <material><ambient>0.5 0.3 0.2 1</ambient><diffuse>0.5 0.3 0.2 1</diffuse></material>
        </visual>
        <!-- 四条腿 -->
        <collision name="leg1_collision">
          <pose>0.45 0.2 0.35 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.7</length></cylinder></geometry>
        </collision>
        <collision name="leg2_collision">
          <pose>-0.45 0.2 0.35 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.7</length></cylinder></geometry>
        </collision>
        <collision name="leg3_collision">
          <pose>0.45 -0.2 0.35 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.7</length></cylinder></geometry>
        </collision>
        <collision name="leg4_collision">
          <pose>-0.45 -0.2 0.35 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.7</length></cylinder></geometry>
        </collision>
      </link>
    </model>

    <!-- 障碍物3：圆柱体（右侧通道变窄） -->
    <model name="cylinder_obstacle">
      <static>true</static>
      <pose>1.5 -0.5 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.25</radius><length>1.2</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>1.2</length></cylinder></geometry>
          <material><ambient>0.6 0.3 0.3 1</ambient><diffuse>0.6 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 障碍物4：小箱子（角落） -->
    <model name="box_obstacle_2">
      <static>true</static>
      <pose>2.0 2.0 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.4 0.4 0.4</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.4 0.4</size></box></geometry>
          <material><ambient>0.6 0.5 0.3 1</ambient><diffuse>0.6 0.5 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== 目标对象 ==================== -->
    <!--
      使用 person_standing 模型（Gazebo 内置）作为导航目标。
      YOLOv8 可以检测到 person。
      机器人任务：检测 person 并导航到其位置。
    -->
    <include>
      <uri>model://person_standing</uri>
      <name>target_person</name>
      <pose>2.0 -1.5 0 0 0 3.1416</pose>
    </include>

    <!-- 第二个目标：瓶子（YOLOv8 可以检测 bottle） -->
    <model name="target_bottle">
      <pose>-1.0 -2.0 0.4 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass value="0.5"/>
          <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.035</radius><length>0.2</length></cylinder></geometry>
        </collision>
        <visual name="body">
          <geometry><cylinder><radius>0.035</radius><length>0.15</length></cylinder></geometry>
          <material><ambient>0.1 0.6 0.1 1</ambient><diffuse>0.1 0.6 0.1 1</diffuse></material>
        </visual>
        <visual name="neck">
          <pose>0 0 0.09 0 0 0</pose>
          <geometry><cylinder><radius>0.015</radius><length>0.05</length></cylinder></geometry>
          <material><ambient>0.1 0.6 0.1 1</ambient><diffuse>0.1 0.6 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ==================== 物理引擎 ==================== -->
    <physics type="ode">
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <!-- 场景背景色（天空色） -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

  </world>
</sdf>
